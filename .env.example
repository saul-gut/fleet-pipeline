# Copia este archivo como .env y ajusta los valores.
# .env nunca se sube al repositorio.

# PostgreSQL + PostGIS (contenedor Docker)
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fleet
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API keys por rol (D-12). Usa valores largos y aleatorios.
API_KEY_DEVICE=change_me_device
API_KEY_ADMIN=change_me_admin
API_KEY_ANALYST=change_me_analyst
